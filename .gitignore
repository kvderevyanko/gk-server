# phpstorm project files
.idea

# netbeans project files
nbproject

# zend studio for eclipse project files
.buildpath
.project
.settings

# windows thumbnail cache
Thumbs.db

# composer vendor dir
/vendor

# Composer executable downloaded for local use
composer.phar

# Mac DS_Store Files
.DS_Store

# phpunit itself is not needed
phpunit.phar
# local phpunit config
/phpunit.xml

tests/_output/*
tests/_support/_generated

#vagrant folder
/.vagrant

.ag.sh
task.php

# Local workspace metadata and infrastructure notes.  These can contain
# hostnames, deployment paths and SSH configuration.
/.codex/
/.local/

# Environment-specific configuration and credentials.
/.env
/.env.*
!/.env.example
/config/local.php
/config/*-local.php
/config/*-local.json
/config/*-local.ini
/.ssh/
*.pem
*.key
*.p12
*.pfx

# Generated or local-only application data.
/db/*.db
/db/*.sqlite
/db/*.sqlite3
/db/*.sqlite-*
/runtime/*
!/runtime/.gitignore
/web/assets/*
!/web/assets/.gitignore
/tests/_output/*
!/tests/_output/.gitignore
*.log
/backups/
